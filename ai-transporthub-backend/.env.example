# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ai-transporthub

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=aitransporthub_super_secret_key_2025
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=aitransporthub_refresh_secret_2025
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google Gemini AI (FREE) ──────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-your-key-here

# ─── Google Maps (optional) ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── OpenWeatherMap (optional) ────────────────────────────────────────────────
WEATHER_API_KEY=

# ─── Cloudinary (optional — for report image uploads) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@transporthub.in

# ─── Firebase (optional — for push notifications) ─────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
